exports[`argv snapshots > rotated.mp4 → apply-rotation 1`] = `
{
  "cmd": "ffmpeg -nostdin -y -hide_banner -i /input/rotated.mp4 -map 0:v:0 -map 0:a:0? -dn -sn -vf 'scale=trunc(iw/2)*2:trunc(ih/2)*2' -pix_fmt yuv420p -c:v libx264 -preset veryfast -crf 20 -c:a copy -movflags +faststart -max_muxing_queue_size 1024 /out/rotated.rotated.mp4",
