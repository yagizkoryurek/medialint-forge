}
`;

exports[`argv snapshots > pcm-audio.mov → audio-to-aac 1`] = `
{
  "cmd": "ffmpeg -nostdin -y -hide_banner -i /input/pcm-audio.mov -map 0:v:0 -map 0:a:0? -dn -sn -c:v copy -c:a aac -b:a 128k -ac 2 -movflags +faststart -max_muxing_queue_size 1024 /out/pcm-audio.fixed.mp4",
  "expected": {
    "dims": {
      "height": 90,
      "width": 160,
    },
    "durationDeltaSec": 0,
    "resolves": [
